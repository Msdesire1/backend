# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=5000

# "development" enables the email fallback that logs OTPs to the console
# instead of requiring SMTP credentials. Use "production" when deploying.
NODE_ENV=development

# ------------------------------------------------------------------ database --
# Local:  mongodb://127.0.0.1:27017/main
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/main
MONGODB_URI=mongodb://127.0.0.1:27017/main

# ---------------------------------------------------------------------- auth --
# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Students and admins are signed with different secrets, so a student token can
# never be replayed against an admin route even if one secret leaks.
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=
# Admin sessions are deliberately shorter than student ones: the console can
# approve payments and issue student IDs.
ADMIN_JWT_EXPIRES_IN=12h

# ------------------------------------------------------------------- clients --
# Origin of the Next.js app. Used for CORS and for password-reset links.
CLIENT_URL=http://localhost:3000
# Optional extra origins, comma separated (e.g. your deployed frontend).
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------- mail --
# On Render Free, use Brevo's HTTPS API (port 443); SMTP ports are blocked.
# Create an API key in Brevo under SMTP & API, then set a verified sender below.
BREVO_API_KEY=
# Leave SMTP blank when using BREVO_API_KEY. SMTP remains useful locally or on
# paid Render instances.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Public PNG/JPG URL used in the branded email header. The default is the
# LFC New Jerusalem logo, so this is only needed to override it.
EMAIL_LOGO_URL=https://wofbi.lfcww.org/assets/image/wofbilogo.png
# In development OTPs are always printed to the server console. In production,
# leave this false. Set it to true only briefly while troubleshooting.
LOG_OTP=false

# --------------------------------------------------------------- admin seed --
# The administrator accounts `npm run seed` creates. Every one of them is a super
# admin, because there is no public admin sign-up route — somebody already inside
# the console has to create the ordinary admins.
#
# Put the church's two official addresses in SEED_ADMIN_EMAILS, comma-separated.
# SEED_ADMIN_NAMES lines up with it position by position.
#
# SEED_ADMIN_PASSWORD is the first-login password for accounts this script
# *creates*. An account that already exists is never given a new password by a
# seed run, so re-seeding to add a lesson cannot reset one somebody has changed.
# Change it from the console after the first sign-in, then blank this line.
#
# Once both real accounts exist, the seed deactivates the old admin@wofbi.local
# placeholder for you. It is deactivated rather than deleted so the applications
# and payments it approved keep pointing at a real record.
SEED_ADMIN_EMAILS=first.office@yourchurch.org,second.office@yourchurch.org
SEED_ADMIN_NAMES=First Administrator,Second Administrator
SEED_ADMIN_PASSWORD=

# The singular forms still work and are treated as a list of one. Kept only so an
# older .env does not break; prefer the plural keys above.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=

# ------------------------------------------------------------ local testing --
# Set to "true" to turn off the sign-in / OTP / upload rate limits. Handy while
# testing the login flow repeatedly. Never set this in production.
DISABLE_RATE_LIMIT=false
